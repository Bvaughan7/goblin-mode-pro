<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Goblin Mode Pro</vendor>
  <vendor_url>https://github.com/Bvaughan7/goblin-mode-pro</vendor_url>

  <!--
    Runtime performance knobs: CPU governor / EPP, process priority (renice, only
    ever toward higher priority and only for a process the caller owns), and the
    RAPL PL1/PL2 power limits (clamped to the firmware maximum). allow_active=yes
    means no password prompt while you are the logged-in session, so a boost can
    be applied the moment a game launches. To require a prompt, change
    allow_active to auth_admin_keep and run `sudo systemctl reload polkit`.
  -->
  <action id="com.goblinmode.pro.manage-performance">
    <description>Tune CPU governor, process priority and power limits</description>
    <message>Authentication is required to tune system performance for a game</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!--
    Persistent kernel tunables applied from the pre-flight check (vm.* map
    count / swappiness / compaction, kernel.split_lock_mitigate,
    user.max_user_namespaces, kernel.unprivileged_userns_clone - each a fixed
    allowlist entry with a numeric range), the nvidia-drm.modeset modprobe.d
    write, and a request to *lower* a power limit / TDP below the firmware
    baseline. These change system behaviour beyond the current game, so they
    always prompt for admin auth.
  -->
  <action id="com.goblinmode.pro.manage-kernel-tunables">
    <description>Set a game-related kernel tunable (sysctl)</description>
    <message>Authentication is required to change a kernel tunable</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!--
    Preemptive fan spin-up (SpinUpFans). This switches a hwmon PWM channel out
    of EC/automatic control, which persists after the calling process dies and
    directly affects the machine's cooling - so it always prompts, unlike the
    promptless runtime knobs above. Restoring EC control (ResetFans) stays on
    manage-performance so it can never be blocked.
  -->
  <action id="com.goblinmode.pro.manage-hardware-thermal">
    <description>Take manual control of the fans for preemptive cooling</description>
    <message>Authentication is required to spin up the fans for a game</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
