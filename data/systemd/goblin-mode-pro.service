[Unit]
Description=Goblin Mode Pro - game performance observer daemon
Documentation=https://github.com/Bvaughan7/goblin-mode-pro
After=graphical-session.target
# No PartOf=graphical-session.target - a session-target reload must not stop
# the daemon mid-game.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/goblin-mode-pro-daemon
ExecStop=/usr/bin/goblin-mode-pro-daemon --revert
Restart=on-failure
RestartSec=3

# Unprivileged: it delegates every root operation to the helper over D-Bus.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryHigh=150M
Nice=5

[Install]
WantedBy=default.target
