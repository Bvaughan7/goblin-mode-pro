[Unit]
Description=Goblin Mode Pro privileged helper
Documentation=https://github.com/Bvaughan7/goblin-mode-pro

[Service]
Type=dbus
BusName=com.goblinmode.ProHelper
ExecStart=/usr/bin/python3 /usr/lib/goblin-mode-pro/goblin_helper.py
ExecStopPost=/usr/bin/python3 /usr/lib/goblin-mode-pro/goblin_helper.py --revert
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# --- sandbox -------------------------------------------------------------
# The only privileged thing it does is write a fixed set of kernel tunables
# and call setpriority(); CAP_SYS_NICE is all it needs.
User=root
CapabilityBoundingSet=CAP_SYS_NICE
AmbientCapabilities=
NoNewPrivileges=yes

RuntimeDirectory=goblin-mode-pro
RuntimeDirectoryMode=0700
UMask=0077

ProtectSystem=strict
ProtectHome=yes
# One ReadWritePaths= entry per line (systemd has no inline comments); the
# comment above each names the helper method(s) that need it. Keep this list
# in sync with SYSFS_WRITE_ROOTS + SYSCTL_ALLOW in goblin_helper.py -
# tests/test_helper_sandbox.py fails the build if they drift.
# SetGovernor, SetEPP
ReadWritePaths=/sys/devices/system/cpu
# SetPowerLimits, ResetPowerLimits (RAPL); second path is the alt sysfs location
ReadWritePaths=/sys/class/powercap
ReadWritePaths=/sys/devices/virtual/powercap
# SpinUpFans, ResetFans
ReadWritePaths=/sys/class/hwmon
# vm.max_map_count / vm.swappiness / vm.compaction_proactiveness
ReadWritePaths=/proc/sys/vm
# kernel.split_lock_mitigate, kernel.unprivileged_userns_clone
ReadWritePaths=/proc/sys/kernel
# user.max_user_namespaces
ReadWritePaths=/proc/sys/user
# SetNvidiaModeset (persistent nvidia_drm.modeset modprobe.d config)
ReadWritePaths=/etc/modprobe.d
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# renice must be able to stat arbitrary /proc/<pid> for the ownership check
ProtectProc=default
PrivateTmp=yes
PrivateDevices=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# PyGObject dispatches our D-Bus handler through a libffi closure. libffi has
# used static (non-writable-executable) trampolines since 3.4.2 (2021), so MDWE
# is safe on every distro the CI .deb/.rpm target: Debian 12 (libffi 3.4.4),
# Ubuntu 22.04 (3.4.2), Fedora, Arch. It would break on libffi < 3.4.2
# (e.g. Ubuntu 20.04) - if a bug report shows "helper down, no error" on such a
# system, this line is the first suspect.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @cpu-emulation @debug @mount @swap @reboot @raw-io @module
SystemCallErrorNumber=EPERM
KeyringMode=private

[Install]
WantedBy=multi-user.target
