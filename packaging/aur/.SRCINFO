pkgbase = goblin-mode-pro-git
	pkgdesc = One-switch performance helper for Linux gaming: auto-detects a game, tunes CPU/compositor/Proton, reverts on exit, diagnoses crashes and FPS drops
	pkgver = 1.3.2.r0.g0000000
	pkgrel = 1
	url = https://github.com/Bvaughan7/goblin-mode-pro
	install = goblin-mode-pro.install
	arch = any
	license = MIT
	makedepends = git
	depends = python
	depends = python-gobject
	depends = python-psutil
	depends = gtk4
	depends = libadwaita>=1.5
	depends = polkit
	optdepends = python-pillow: tray icon rendering
	optdepends = python-pystray: system tray icon
	optdepends = mangohud: FPS overlay and the frame-rate watchdog
	optdepends = gamemode: extra per-game GPU/ioprio tuning via the launch wrapper
	optdepends = gamescope: the per-game gamescope integration
	optdepends = wl-clipboard: clipboard export on Wayland
	optdepends = ryzenadj: AMD laptop TDP control
	optdepends = scx-scheds: per-game sched_ext CPU scheduler (scx_lavd, scx_bpfland, ...)
	optdepends = python-cairo: saving a benchmark report card as an image
	provides = goblin-mode-pro
	conflicts = goblin-mode-pro
