# Maintainer: Bryan Vaughan <bryanvaughan07@gmail.com>
#
# Tagged-release PKGBUILD. For the rolling build, use ../aur/ (goblin-mode-pro-git).
# Split package. Only the Rust helper is compiled, so only IT is
# architecture-specific: the main package stays arch=('any') and installs
# anywhere. pkgbase is x86_64 because that is what Arch Linux itself supports
# (Arch Linux ARM is a separate distribution with its own tree); on anything
# else, use install.sh, which defaults to the Python helper and needs no
# toolchain.
pkgbase=goblin-mode-pro
pkgname=('goblin-mode-pro' 'goblin-mode-pro-helper-rust')
pkgver=1.3.2
pkgrel=1
pkgdesc="One-switch performance helper for Linux gaming: auto-detects a game, tunes CPU/compositor/Proton, reverts on exit, diagnoses crashes and FPS drops"
arch=('x86_64')
makedepends=('cargo')
url="https://github.com/Bvaughan7/goblin-mode-pro"
license=('MIT')
# libadwaita>=1.5: AlertDialog / AboutDialog / Breakpoint - see
# MIN_ADW_VERSION in src/goblinmode/gui/app.py
depends=('python' 'python-gobject' 'python-psutil' 'gtk4' 'libadwaita>=1.5' 'polkit')
optdepends=(
  'python-pillow: tray icon rendering'
  'python-pystray: system tray icon'
  'mangohud: FPS overlay and the frame-rate watchdog'
  'gamemode: extra per-game GPU/ioprio tuning via the launch wrapper'
  'gamescope: the per-game gamescope integration'
  'wl-clipboard: clipboard export on Wayland'
  'ryzenadj: AMD laptop TDP control'
  'scx-scheds: per-game sched_ext CPU scheduler (scx_lavd, scx_bpfland, ...)'
  'python-cairo: saving a benchmark report card as an image'
)
source=("$pkgbase-$pkgver.tar.gz::https://github.com/Bvaughan7/goblin-mode-pro/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgbase-$pkgver"
  cargo build --release --locked -p gmp-helper
}

package_goblin-mode-pro() {
  arch=('any')
  install="$pkgbase.install"
  cd "$pkgbase-$pkgver"
  local pkgname="$pkgbase"
  local libdir="$pkgdir/usr/lib/$pkgname"

  install -d "$libdir"
  cp -rT src/goblinmode "$libdir/goblinmode"
  python -m compileall -q "$libdir/goblinmode" || true
  install -Dm0755 helper/goblin_helper.py "$libdir/goblin_helper.py"
  # the unit runs this symlink, not the file directly - see install.sh
  install -d "$pkgdir/usr/libexec/$pkgname"
  ln -sfn "/usr/lib/$pkgname/goblin_helper.py" "$pkgdir/usr/libexec/$pkgname/helper"

  _shim() {
    install -d "$pkgdir/usr/bin"
    printf '#!/usr/bin/python3\nimport sys\nsys.path.insert(0, "/usr/lib/%s")\nfrom %s import main\nraise SystemExit(main())\n' \
      "$pkgname" "$2" > "$pkgdir/usr/bin/$1"
    chmod 0755 "$pkgdir/usr/bin/$1"
  }
  _shim goblin-mode-pro-daemon goblinmode.daemon
  _shim goblin-mode-pro        goblinmode.gui.app
  _shim goblin-mode-pro-cli    goblinmode.cli

  install -Dm0644 data/polkit/com.goblinmode.pro.policy \
    "$pkgdir/usr/share/polkit-1/actions/com.goblinmode.pro.policy"
  install -Dm0644 data/dbus/com.goblinmode.ProHelper.conf \
    "$pkgdir/usr/share/dbus-1/system.d/com.goblinmode.ProHelper.conf"
  install -Dm0644 data/systemd/goblin-mode-pro-helper.service \
    "$pkgdir/usr/lib/systemd/system/goblin-mode-pro-helper.service"
  install -Dm0644 data/systemd/goblin-mode-pro.service \
    "$pkgdir/usr/lib/systemd/user/goblin-mode-pro.service"
  install -Dm0644 data/com.goblinmode.Pro.desktop \
    "$pkgdir/usr/share/applications/com.goblinmode.Pro.desktop"
  install -Dm0644 data/com.goblinmode.Pro.GamescopeSession.desktop \
    "$pkgdir/usr/share/applications/com.goblinmode.Pro.GamescopeSession.desktop"
  install -Dm0644 data/icons/com.goblinmode.Pro.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.goblinmode.Pro.svg"
  # PNG icons (Qt/KDE can't render the SVG's CSS + filters)
  for _png in data/icons/hicolor/*/apps/*.png; do
    install -Dm0644 "$_png" "$pkgdir/usr/share/icons/${_png#data/icons/}"
  done
  install -Dm0644 data/systemd/helper-amd-tdp.conf \
    "$pkgdir/usr/share/$pkgname/helper-amd-tdp.conf"
  install -Dm0644 data/systemd/helper-undervolt.conf \
    "$pkgdir/usr/share/$pkgname/helper-undervolt.conf"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

# Installing this does NOT switch to it. The unit runs
# /usr/libexec/goblin-mode-pro/helper, a symlink the main package points at the
# Python helper; relink and restart to switch, relink back to roll back. The
# Python helper is always installed, so a rollback never needs a toolchain.
package_goblin-mode-pro-helper-rust() {
  pkgdesc="Goblin Mode Pro privileged helper, Rust implementation (optional; relink to enable)"
  depends=('goblin-mode-pro')
  cd "$pkgbase-$pkgver"
  install -Dm0755 target/release/gmp-helper \
    "$pkgdir/usr/libexec/$pkgbase/helper-rust"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
